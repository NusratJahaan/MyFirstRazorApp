<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Court Case</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2026.2.520/js/kendo.all.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2026.2.520/js/kendo.aspnetmvc.min.js"></script>
</head>
<body>
    <!-- Top Header -->
    <header class="bg-dark text-white py-2 px-3 d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-bank2 fs-4"></i>
            <span class="fw-bold">Court Case Management</span>
        </div>
        <div class="d-flex align-items-center gap-3 small">
            <span><i class="bi bi-person-circle me-1"></i>@User.Identity?.Name</span>
            <span class="text-white-50">Logged On: @DateTime.Now.ToString("MMM-dd-yyyy HH:mm tt")</span>
            <form method="post" asp-page="/Account/Logout" class="d-inline m-0">
                <button type="submit" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </header>

    <div class="d-flex" style="min-height: calc(100vh - 120px);">
        <!-- Sidebar -->
        <aside class="bg-light border-end" style="width: 240px; min-width: 240px;">
            <nav class="nav flex-column p-2">
                <a class="nav-link text-dark py-2 px-3 rounded mb-1" asp-page="/CourtCase/Complaints/Details" asp-route-id="@ViewData["ComplaintId"]">
                    <i class="bi bi-person-vcard me-2"></i> Defendant Summary
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded mb-1" asp-page="/CourtCase/Offences/Index" asp-route-complaintId="@ViewData["ComplaintId"]">
                    <i class="bi bi-exclamation-triangle me-2"></i> Offences
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded mb-1" asp-page="/CourtCase/Witnesses/Index" asp-route-complaintId="@ViewData["ComplaintId"]">
                    <i class="bi bi-people me-2"></i> Witnesses
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded mb-1" asp-page="/CourtCase/Warrants/Index" asp-route-complaintId="@ViewData["ComplaintId"]">
                    <i class="bi bi-file-earmark-text me-2"></i> Warrants
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded mb-1" asp-page="/CourtCase/Judgements/Index" asp-route-complaintId="@ViewData["ComplaintId"]">
                    <i class="bi bi-hammer me-2"></i> Judgements
                </a>
                <a class="nav-link text-dark py-2 px-3 rounded mb-1" asp-page="/CourtCase/Complaints/Manage" asp-route-id="@ViewData["ComplaintId"]">
                    <i class="bi bi-gear me-2"></i> Manage Case
                </a>
                <hr />
                <a class="nav-link text-muted py-2 px-3 rounded mb-1" asp-page="/CourtCase/Complaints/Index">
                    <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
                </a>
            </nav>
        </aside>

        <!-- Main Content -->
        <main class="flex-grow-1 p-4">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>