@page "{id:int}"
@model MyFirstRazorApp.Pages.CourtCase.Offences.EditModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Edit Offence";
    ViewData["ComplaintId"] = Model.Complaint.Id;
}

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                <a asp-page="List" asp-route-complaintId="@Model.Complaint.Id"
                   class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center"
                   style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-dark fw-bold mb-0">Edit Offence</h2>
                    <p class="text-muted small mb-0">File #@Model.Offence.FileNumber</p>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <!-- Hidden fields -->
                        <input type="hidden" asp-for="Offence.Id" />
                        <input type="hidden" asp-for="Offence.ComplaintId" />
                        <input type="hidden" asp-for="Offence.FileNumber" />
                        <input type="hidden" asp-for="Offence.CreatedBy" />
                        <input type="hidden" asp-for="Offence.CreatedDate" />
                        <input type="hidden" asp-for="Offence.OffenceStatus" />
                        <input type="hidden" asp-for="Offence.CaseStatus" />
                        <input type="hidden" asp-for="Offence.IsApproved" />
                        <input type="hidden" asp-for="Offence.FinishedAndLocked" />

                        <!-- File Number Display (read-only) -->
                        <div class="alert alert-info small mb-4">
                            <i class="bi bi-info-circle me-1"></i>
                            File Number: <strong>@Model.Offence.FileNumber</strong>
                        </div>

                        <!-- Offence Type Dropdown -->
                        <div class="mb-4">
                            <label asp-for="Offence.OffenceLookUpId" class="form-label fw-semibold text-secondary">Offence Type</label>
                            <select asp-for="Offence.OffenceLookUpId" class="form-select" asp-items="Model.OffenceTypes">
                                <option value="">-- Select Offence Type --</option>
                            </select>
                            <span asp-validation-for="Offence.OffenceLookUpId" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Offence.Description" class="form-label fw-semibold text-secondary">Description</label>
                            <textarea asp-for="Offence.Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Offence.Description" class="text-danger small"></span>
                        </div>

                        <hr class="text-secondary opacity-25 my-4">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="List" asp-route-complaintId="@Model.Complaint.Id"
                               class="btn btn-light border px-4 text-secondary rounded-pill">
                                Cancel
                            </a>
                            <button type="submit"
                                    class="btn btn-primary px-4 shadow-sm rounded-pill d-flex align-items-center gap-2">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}