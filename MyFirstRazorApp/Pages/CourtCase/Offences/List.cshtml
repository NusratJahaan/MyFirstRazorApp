@page
@using Kendo.Mvc.UI
@using MyFirstRazorApp.Models
@model MyFirstRazorApp.Pages.CourtCase.Offences.ListModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Offences";
    ViewData["ComplaintId"] = Model.Complaint.Id;

    var offenceTypes = Model.OffenceLookUps.ToDictionary(l => l.Id, l => l.Description);

    var detailsUrl = Url.Page("Details", new { id = 0 })?.Replace("/0", "/#= Id #");
    var editUrl = Url.Page("Edit", new { id = 0 })?.Replace("/0", "/#= Id #");

    var isPending = "(OffenceStatus == " + (int)OffenceStatus.Pending + " || OffenceStatus == 'Pending')";
    var isApproved = "(OffenceStatus == " + (int)OffenceStatus.Approved + " || OffenceStatus == 'Approved')";
    var isActive = "(CaseStatus == " + (int)CaseStatus.Active + " || CaseStatus == 'Active')";
}

<style>
    .k-grid {
        font-size: 13px;
    }

        .k-grid td {
            vertical-align: middle;
        }

    .st-pending {
        color: #b26a00;
    }

    .st-approved {
        color: #1b7f3b;
    }

    .st-declined {
        color: #c62828;
    }

    .st-inactive {
        color: #6c757d;
    }

    .row-actions a, .row-actions button {
        background: none;
        border: 0;
        padding: 0;
        margin-right: 12px;
        color: #0d6efd;
        cursor: pointer;
        text-decoration: none;
        font-size: 13px;
    }

        .row-actions a:hover, .row-actions button:hover {
            text-decoration: underline;
        }

    .row-actions .act-approve {
        color: #1b7f3b;
    }

    .row-actions .act-decline {
        color: #c62828;
    }
</style>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0">Offences</h4>
        <div class="text-muted small">Complaint #@Model.Complaint.ComplaintNumber — @Model.Complaint.DefendantName</div>
    </div>
    <a asp-page="Add" asp-route-complaintId="@Model.Complaint.Id" class="k-button k-button-solid k-button-solid-primary">
        Add New Offence
    </a>
</div>

<!-- Hidden Forms for Approve/Decline -->
<form method="post" asp-page-handler="Approve" id="approveForm" class="d-none">
    <input type="hidden" name="id" id="approveId" />
    <input type="hidden" name="complaintId" value="@Model.Complaint.Id" />
</form>
<form method="post" asp-page-handler="Decline" id="declineForm" class="d-none">
    <input type="hidden" name="id" id="declineId" />
    <input type="hidden" name="complaintId" value="@Model.Complaint.Id" />
</form>

<script>
    var offenceTypes = @Html.Raw(Json.Serialize(offenceTypes));
</script>

@(Html.Kendo().Grid(Model.Offences)
    .Name("offencesGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.FileNumber).Title("File Number").Width(150);

        columns.Bound(o => o.OffenceLookUpId).Title("Offence Type").Width(200)
            .Filterable(false)
            .ClientTemplate("#= offenceTypes[OffenceLookUpId] || 'Unknown' #");

        columns.Bound(o => o.Description).Title("Description");

        columns.Bound(o => o.OffenceStatus).Title("Status").Width(110)
            .Filterable(false)
            .ClientTemplate(
                "# if (" + isPending + ") { #<span class='st-pending'>Pending</span># } " +
                "else if (" + isApproved + ") { #<span class='st-approved'>Approved</span># } " +
                "else { #<span class='st-declined'>Declined</span># } #"
            );

        columns.Bound(o => o.CaseStatus).Title("Case").Width(90)
            .Filterable(false)
            .ClientTemplate(
                "# if (" + isActive + ") { #<span class='st-approved'>Active</span># } " +
                "else { #<span class='st-inactive'>Inactive</span># } #"
            );

        columns.Bound(o => o.Id).Title("Actions")
            .Sortable(false).Filterable(false).Width(240)
            .ClientTemplate(
                "<div class='row-actions'>" +
                "<a href='" + detailsUrl + "'>View</a>" +
                "<a href='" + editUrl + "'>Edit</a>" +
                "# if (!IsApproved && " + isPending + ") { #" +
                    "<button type='button' class='act-approve' onclick='approveOffence(#= Id #);'>Approve</button>" +
                    "<button type='button' class='act-decline' onclick='declineOffence(#= Id #);'>Decline</button>" +
                "# } #" +
                "</div>"
            );
    })
    .Pageable(p => p.PageSizes(new[] { 10, 20, 50 }))
    .Sortable()
    .Filterable()
    .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
    .NoRecords(n => n.Template(
        "<div class='py-4 text-center text-muted'>No offences found. Click \"Add New Offence\" to create one.</div>"
    ))
)

@section Scripts {
    <script>
        function approveOffence(id) {
            if (confirm('Approve this offence?')) {
                document.getElementById('approveId').value = id;
                document.getElementById('approveForm').submit();
            }
        }

        function declineOffence(id) {
            if (confirm('Decline this offence?')) {
                document.getElementById('declineId').value = id;
                document.getElementById('declineForm').submit();
            }
        }
    </script>
}