@page
@model MyFirstRazorApp.Pages.CourtCase.Offences.AddModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Add Offence";
    ViewData["ComplaintId"] = Model.Complaint.Id;
}

<style>
    /* Centers the layout footer text */
    footer {
        text-align: center !important;
    }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <!-- Hidden fields -->
                        <input type="hidden" asp-for="Offence.ComplaintId" />
                        <input type="hidden" asp-for="Offence.CreatedBy" />
                        <input type="hidden" asp-for="Offence.UpdatedBy" />
                        <input type="hidden" asp-for="Offence.CreatedDate" />
                        <input type="hidden" asp-for="Offence.UpdatedDate" />

                        <!-- Offence Type Dropdown -->
                        <div class="mb-4">
                            <label asp-for="Offence.OffenceLookUpId" class="form-label fw-semibold text-secondary">Offence Type</label>
                            <select asp-for="Offence.OffenceLookUpId" class="form-select" asp-items="Model.OffenceTypes">
                                <option value="">-- Select Offence Type --</option>
                            </select>
                            <span asp-validation-for="Offence.OffenceLookUpId" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-4">
                            <label asp-for="Offence.Description" class="form-label fw-semibold text-secondary">Description</label>
                            <textarea asp-for="Offence.Description" class="form-control" rows="4"
                                      placeholder="Describe the offence..."></textarea>
                            <span asp-validation-for="Offence.Description" class="text-danger small"></span>
                        </div>

                        <hr class="text-secondary opacity-25 my-4">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="./List" asp-route-complaintId="@Model.Complaint.Id"
                               class="btn btn-light border px-4 text-secondary rounded-pill">
                                Cancel
                            </a>
                            <button type="submit"
                                    class="btn btn-primary px-4 shadow-sm rounded-pill d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle"></i> Add Offence
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}