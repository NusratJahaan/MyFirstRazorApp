@page "{id:int}"
@using MyFirstRazorApp.Models
@model MyFirstRazorApp.Pages.CourtCase.Offences.DetailsModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Offence Details";
    ViewData["ComplaintId"] = Model.Complaint.Id;
}

<div class="d-flex align-items-center mb-4 pb-2 border-bottom">
    <a asp-page="List" asp-route-complaintId="@Model.Complaint.Id"
       class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center"
       style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h2 class="text-dark fw-bold mb-0">Offence Details</h2>
        <p class="text-muted small mb-0">File #@Model.Offence.FileNumber</p>
    </div>
</div>

<!-- Offence Information Card -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="text-dark fw-bold mb-0">
                <i class="bi bi-exclamation-triangle me-2 text-primary"></i>Offence Information
            </h5>

            @if (!Model.Offence.IsApproved && Model.Offence.OffenceStatus == OffenceStatus.Pending)
            {
                <div>
                    <form method="post" asp-page-handler="Approve" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Offence.Id" />
                        <button type="submit" class="btn btn-sm btn-light border text-success"
                                onclick="return confirm('Approve this offence?');">
                            <i class="bi bi-check-circle"></i> Approve
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Decline" class="d-inline">
                        <input type="hidden" name="id" value="@Model.Offence.Id" />
                        <button type="submit" class="btn btn-sm btn-light border text-danger"
                                onclick="return confirm('Decline this offence?');">
                            <i class="bi bi-x-circle"></i> Decline
                        </button>
                    </form>
                </div>
            }
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted fw-semibold">File Number</dt>
            <dd class="col-sm-9">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                    @Model.Offence.FileNumber
                </span>
            </dd>

            <dt class="col-sm-3 text-muted fw-semibold">Offence Type</dt>
            <dd class="col-sm-9 text-dark fw-medium">@Model.OffenceTypeName</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Offence.Description) ? "—" : Model.Offence.Description)</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Offence.OffenceStatus == OffenceStatus.Pending)
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-3 py-2 rounded-pill">Pending</span>
                }
                else if (Model.Offence.OffenceStatus == OffenceStatus.Approved)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill">Approved</span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 rounded-pill">Declined</span>
                }
            </dd>

            <dt class="col-sm-3 text-muted fw-semibold">Case Status</dt>
            <dd class="col-sm-9">
                @if (Model.Offence.CaseStatus == CaseStatus.Active)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2 rounded-pill">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3 text-muted fw-semibold">Finished & Locked</dt>
            <dd class="col-sm-9">
                @if (Model.Offence.FinishedAndLocked)
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-lock-fill me-1"></i>Yes
                    </span>
                }
                else
                {
                    <span class="text-muted small">No</span>
                }
            </dd>

            <dt class="col-sm-3 text-muted fw-semibold">Linked Complaint</dt>
            <dd class="col-sm-9">
                <a asp-page="/CourtCase/Complaints/Details" asp-route-id="@Model.Complaint.Id" class="text-primary text-decoration-none">
                    @Model.Complaint.ComplaintNumber — @Model.Complaint.DefendantName
                </a>
            </dd>
        </dl>
    </div>
</div>

<!-- Record Information Card -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden">
    <div class="card-body p-4">
        <h6 class="text-secondary fw-semibold mb-3">
            <i class="bi bi-info-circle me-2"></i>Record Information
        </h6>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small mb-1">Created By</label>
                <p class="text-dark mb-0 small">
                    <i class="bi bi-person-circle me-1 text-muted"></i>@(Model.Offence.CreatedBy ?? "—")
                </p>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small mb-1">Created Date</label>
                <p class="text-dark mb-0 small">
                    <i class="bi bi-calendar me-1 text-muted"></i>@Model.Offence.CreatedDate.ToString("MMM dd, yyyy hh:mm tt")
                </p>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small mb-1">Last Updated By</label>
                <p class="text-dark mb-0 small">
                    <i class="bi bi-person-circle me-1 text-muted"></i>@(Model.Offence.UpdatedBy ?? "—")
                </p>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold text-secondary small mb-1">Last Updated Date</label>
                <p class="text-dark mb-0 small">
                    <i class="bi bi-calendar me-1 text-muted"></i>@(Model.Offence.UpdatedDate?.ToString("MMM dd, yyyy hh:mm tt") ?? "—")
                </p>
            </div>
        </div>
    </div>
</div>