@page
@using Kendo.Mvc.UI
@using MyFirstRazorApp.Models
@model MyFirstRazorApp.Pages.CourtCase.Warrants.ListModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Warrants";
    ViewData["ComplaintId"] = Model.Complaint.Id;

   var detailsUrl = Url.Page("Details", new { id = 0 })?.Replace("/0", "/#= Id #");
var editUrl = Url.Page("Edit", new { id = 0 })?.Replace("/0", "/#= Id #");
var rosUrl = detailsUrl + "\\#ros-section";
}

<style>
    .st-open { color: #1b7f3b; }
    .st-locked { color: #c62828; }
</style>

<div class="tl-section-bar">
    <div class="tl-banner">Warrants</div>
    <span class="badge-count">@Model.Warrants.Count</span>
    <a asp-page="Add" asp-route-complaintId="@Model.Complaint.Id" class="k-button k-button-solid k-button-solid-primary btn-sky">
        Add New Warrant
    </a>
</div>

<!-- Hidden Delete Form -->
<form method="post" asp-page-handler="Delete" id="deleteForm" class="d-none">
    <input type="hidden" name="id" id="deleteId" />
    <input type="hidden" name="complaintId" value="@Model.Complaint.Id" />
</form>

@(Html.Kendo().Grid(Model.Warrants)
    .Name("warrantsGrid")
    .Columns(columns =>
    {
        columns.Bound(w => w.CaseNumbers).Title("Case Numbers");

        columns.Bound(w => w.IssuedDate).Title("Issued Date").Width(150)
            .Filterable(false)
            .ClientTemplate("#= kendo.toString(kendo.parseDate(IssuedDate), 'MMM dd, yyyy') #");

        columns.Bound(w => w.OfficialName).Title("Official").Width(200);

        columns.Bound(w => w.FinishedAndLocked).Title("Status").Width(100)
            .Filterable(false)
            .ClientTemplate(
                "# if (FinishedAndLocked) { #<span class='st-locked'>Locked</span># } " +
                "else { #<span class='st-open'>Open</span># } #"
            );

        columns.Bound(w => w.Id).Title("Actions")
            .Sortable(false).Filterable(false).Width(260)
            .ClientTemplate(
                "<div class='row-actions'>" +
                "<a href='" + detailsUrl + "'>View</a>" +
                "<a href='" + rosUrl + "'>ROS</a>" +
                "# if (!FinishedAndLocked) { #" +
                    "<a href='" + editUrl + "'>Edit</a>" +
                    "<button type='button' class='act-delete' onclick='deleteWarrant(#= Id #);'>Delete</button>" +
                "# } #" +
                "</div>"
            );
    })
    .Pageable(p => p.PageSizes(new[] { 10, 20, 50 }))
    .Sortable()
    .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
    .NoRecords(n => n.Template(
        "<div class='py-4 text-center text-muted'>No warrants found. Click \"Add New Warrant\" to create one.</div>"
    ))
)

@section Scripts {
    <script>
        function deleteWarrant(id) {
            if (confirm('Delete this warrant?')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}