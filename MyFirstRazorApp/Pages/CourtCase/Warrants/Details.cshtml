@page "{id:int}"
@using MyFirstRazorApp.Models
@model MyFirstRazorApp.Pages.CourtCase.Warrants.DetailsModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Warrant Details";
    ViewData["ComplaintId"] = Model.Complaint.Id;
}

<div class="d-flex align-items-center mb-4 pb-2 border-bottom">
    <a asp-page="List" asp-route-complaintId="@Model.Complaint.Id"
       class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center"
       style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h2 class="text-dark fw-bold mb-0">Warrant Details</h2>
        <p class="text-muted small mb-0">Complaint #@Model.Complaint.ComplaintNumber — @Model.Complaint.DefendantName</p>
    </div>
</div>

<!-- Warrant Information -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
    <div class="card-body p-4">
        <h5 class="text-dark fw-bold mb-3">
            <i class="bi bi-file-earmark-text me-2 text-primary"></i>Warrant Information
        </h5>

        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted fw-semibold">Case Numbers</dt>
            <dd class="col-sm-9 text-dark fw-medium">@Model.Warrant.CaseNumbers</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Issued Date</dt>
            <dd class="col-sm-9">@Model.Warrant.IssuedDate.ToString("MMM dd, yyyy")</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Official Name</dt>
            <dd class="col-sm-9">@Model.Warrant.OfficialName</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Official Sign Date</dt>
            <dd class="col-sm-9">@Model.Warrant.OfficialSignDate.ToString("MMM dd, yyyy")</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Warrant.FinishedAndLocked)
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-lock-fill me-1"></i>Finished & Locked
                    </span>
                }
                else
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill">Open</span>
                }
            </dd>
        </dl>
    </div>
</div>

<!-- Return of Service Section -->
<!-- Return of Service Section -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4" id="ros-section">
    <div class="card-body p-4 pb-3">
        <h5 class="text-dark fw-bold mb-0">
            <i class="bi bi-file-check me-2 text-primary"></i>Return of Service
        </h5>
    </div>

    @if (Model.ReturnsOfService.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4 py-3 text-secondary fw-semibold">Served Date</th>
                        <th class="py-3 text-secondary fw-semibold">Status</th>
                        <th class="py-3 text-secondary fw-semibold">Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ros in Model.ReturnsOfService)
                    {
                        <tr>
                            <td class="px-4 text-muted small">
                                @(ros.ServedDate == default ? "—" : ros.ServedDate.ToString("MMM dd, yyyy"))
                            </td>
                            <td>
                                @if (ros.ServiceStatus == ServiceStatus.Pending)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-3 py-2 rounded-pill">Pending</span>
                                }
                                else if (ros.ServiceStatus == ServiceStatus.Served)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill">Served</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 rounded-pill">Not Served</span>
                                }
                            </td>
                            <td class="text-muted small">@(string.IsNullOrEmpty(ros.Remarks) ? "—" : ros.Remarks)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-4">
            <p class="text-muted mb-0">No returns of service yet.</p>
        </div>
    }
</div>

<!-- Action Buttons -->
<div class="d-flex justify-content-end gap-3">
    @if (Model.CanAddRos)
    {
        <a asp-page="/CourtCase/ReturnOfServices/Add" asp-route-warrantId="@Model.Warrant.Id"
           class="btn btn-primary px-4 shadow-sm rounded-pill d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Add Return of Service
        </a>
    }

    @if (!Model.Warrant.FinishedAndLocked)
    {
        <form method="post" asp-page-handler="Lock" class="d-inline">
            <input type="hidden" name="id" value="@Model.Warrant.Id" />
            <button type="submit" class="btn btn-danger px-4 shadow-sm rounded-pill d-flex align-items-center gap-2"
                    onclick="return confirm('Finish and lock this warrant? No further changes will be allowed.');">
                <i class="bi bi-lock-fill"></i> Finish & Lock
            </button>
        </form>
    }
</div>