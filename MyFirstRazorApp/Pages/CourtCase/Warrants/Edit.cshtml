@page "{id:int}"
@model MyFirstRazorApp.Pages.CourtCase.Warrants.EditModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Edit Warrant";
    ViewData["ComplaintId"] = Model.Complaint.Id;
}

<style>
    /* Centers the layout footer text */
    footer {
        text-align: center !important;
    }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <!-- Hidden fields required for model state on post -->
                        <input type="hidden" asp-for="Warrant.Id" />
                        <input type="hidden" asp-for="Warrant.ComplaintId" />
                        <input type="hidden" asp-for="Warrant.CreatedBy" />
                        <input type="hidden" asp-for="Warrant.CreatedDate" />
                        <input type="hidden" asp-for="Warrant.FinishedAndLocked" />

                        <partial name="_WarrantForm" for="Warrant" />

                        <hr class="text-secondary opacity-25 my-4">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="./List" asp-route-complaintId="@Model.Complaint.Id"
                               class="btn btn-light border px-4 text-secondary rounded-pill">
                                Cancel
                            </a>
                            <button type="submit"
                                    class="btn btn-primary px-4 shadow-sm rounded-pill d-flex align-items-center gap-2">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}