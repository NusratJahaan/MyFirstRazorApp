@page
@using Kendo.Mvc.UI
@using MyFirstRazorApp.Services.CourtCase
@inject IOffenceLookUpService OffenceLookUpService
@model MyFirstRazorApp.Pages.CourtCase.Search.IndexModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Search";

    var offenceTypes = await OffenceLookUpService.GetAllAsync();
}

<style>
    .tl-search-page {
        background: #f4fbfd;
        padding: 4px 0 10px;
        font-family: "Segoe UI", "Open Sans", Arial, Helvetica, sans-serif;
    }

    .tl-page-title {
        font-size: 26px;
        font-weight: 300;
        color: #000;
        margin: 4px 0 10px;
        line-height: 1.2;
    }

    .search-card {
        background: #ffffff;
        border: 1px solid #cfe3ec;
        border-radius: 4px;
        padding: 14px 14px 16px;
        margin-bottom: 8px;
    }

        .search-card .form-label {
            font-size: 13px;
            font-weight: 400;
            color: #222;
            margin-bottom: 4px;
        }

        .search-card .form-control,
        .search-card .form-select {
            font-size: 13px;
            height: 32px;
            padding: 3px 9px;
            border: 1px solid #ced4da;
            border-radius: 3px;
            background-color: #ffffff;
            box-shadow: none;
        }

            .search-card .form-control:focus,
            .search-card .form-select:focus {
                border-color: #29a9d6;
                box-shadow: 0 0 0 0.12rem rgba(41, 169, 214, 0.18);
            }

    .search-actions {
        margin-top: 14px;
        display: flex;
        gap: 6px;
    }

    .tl-results {
        background: #ffffff;
        border: 1px solid #cfe3ec;
        border-radius: 4px;
        overflow: hidden;
    }

    .tl-results-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 10px;
        font-size: 13px;
        color: #12607e;
        background: #e8f6fc;
        border-bottom: 1px solid #bfe1ef;
    }

        .tl-results-bar strong {
            font-weight: 700;
        }

    .search-card .k-dropdownlist,
    .search-card .k-multicolumncombobox,
    .search-card .k-combobox {
        width: 100%;
        height: 32px;
        font-size: 13px;
        color: #000;
        background-color: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 3px;
        box-shadow: none;
    }

        .search-card .k-multicolumncombobox .k-input-inner {
            font-size: 13px;
            padding: 3px 9px;
            color: #000;
        }

    .k-list-container .k-table-th,
    .k-list-container th {
        background-color: #f8f9fa !important;
        color: #000 !important;
        font-weight: 400;
        font-size: 14px;
        padding: 9px 10px !important;
        border-color: #dfe3e8 !important;
    }

    .k-list-container .k-table-td,
    .k-list-container td {
        font-size: 14px;
        color: #000;
        padding: 9px 10px !important;
        border-color: #eceff2 !important;
    }

    .k-list-container .k-table-row:nth-child(even) td {
        background-color: #f6f7f8;
    }
</style>

<div class="tl-search-page">

    <div class="tl-page-title">Pending Offence Search</div>

    <div class="search-card">
        <form method="get">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">File Number</label>
                    <input type="text" asp-for="Search.FileNumber" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Defendant Name</label>
                    <input type="text" asp-for="Search.DefendantName" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Offence Type</label>
                    @(Html.Kendo().MultiColumnComboBox()
                        .Name("Search.OffenceLookUpId")
                        .Placeholder("All")
                        .DataTextField("Text")
                        .DataValueField("Value")
                        .Filter("contains")
                        .FilterFields(new string[] { "Text" })
                        .Columns(columns =>
                        {
                            columns.Add().Field("Text").Title("Offence Type");
                        })
                        .BindTo(offenceTypes.Select(o => new { Value = o.Id, Text = o.Description }))
                        .Value(Model.Search.OffenceLookUpId?.ToString())
                        .Height(300)
                        .Events(e => e.Change("onOffenceChange"))
                        .HtmlAttributes(new { style = "width: 100%;" })
                    )
                </div>

                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" asp-for="Search.FromDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" asp-for="Search.ToDate" class="form-control" />
                </div>
            </div>

            <div class="search-actions">
                <button type="submit" class="btn-search">Search</button>
                <a href="/CourtCase/Search/Index" class="btn-clear">Clear</a>
            </div>
        </form>
    </div>

    @if (Model.Search.Results.Count > 0)
    {
        <div class="tl-results">
            <div class="tl-results-bar">
                <span><strong>Results</strong> &nbsp;(@Model.Search.Results.Count() found)</span>
            </div>

            @(Html.Kendo().Grid(Model.Search.Results)
                .Name("searchResultsGrid")
                .Columns(columns =>
                {
                    columns.Bound(o => o.FileNumber).Title("File Number").Width(150);
                    columns.Bound(o => o.OffenceType).Title("Offence Type");
                    columns.Bound(o => o.DefendantName).Title("Defendant").Width(200);
                    columns.Bound(o => o.ComplaintNumber).Title("Complaint #").Width(150);

                    columns.Bound(o => o.CreatedDate).Title("Created").Width(130)
                        .Filterable(false)
                        .ClientTemplate("#= kendo.toString(kendo.parseDate(CreatedDate), 'MMM dd, yyyy') #");

                    columns.Bound(o => o.Id).Title("").Sortable(false).Filterable(false).Width(110)
                        .ClientTemplate(
                            "<a href='/CourtCase/Offences/Details/#= Id #' class='btn-review'>Review</a>"
                        );
                })
                .Pageable(p => p
                    .PageSizes(new[] { 10, 20, 50 })
                    .Messages(m => m
                        .Display("{0} - {1} of {2} items")
                        .Empty("No items to display")
                    )
                )
                .Sortable()
                .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
                .NoRecords(n => n.Template(
                    "<div class='py-4 text-center text-muted'>No offences match your search.</div>"
                ))
            )
        </div>
    }

    <script>
            function onOffenceChange() {
                if (this.select() === -1 && this.value() !== "") {
                    this.value("");
                }
            }
    </script>

</div>