@page
@using Kendo.Mvc.UI
@model MyFirstRazorApp.Pages.CourtCase.Judgements.ListModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Judgements";
    ViewData["ComplaintId"] = Model.Complaint.Id;

    var detailsUrl = Url.Page("Details", new { id = "__ID__" })?.Replace("__ID__", "#= FirstJudgementId #");
    var editUrl = Url.Page("Edit", new { id = "__ID__" })?.Replace("__ID__", "#= FirstJudgementId #");
}

<style>
    .k-grid { font-size: 13px; }
    .k-grid td { vertical-align: middle; }
    .st-final { color: #1b7f3b; }
    .st-draft { color: #b26a00; }
    .row-actions a {
        color: #0d6efd; text-decoration: none; font-size: 13px; margin-right: 12px;
    }
    .row-actions a:hover { text-decoration: underline; }
</style>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0">Judgements</h4>
        <div class="text-muted small">Complaint #@Model.Complaint.ComplaintNumber — @Model.Complaint.DefendantName</div>
    </div>
    <a asp-page="Add" asp-route-complaintId="@Model.Complaint.Id" class="k-button k-button-solid k-button-solid-primary">
        Add New Judgement
    </a>
</div>

@(Html.Kendo().Grid(Model.JudgementBatches)
    .Name("judgementsGrid")
    .Columns(columns =>
    {
        columns.Bound(b => b.JudgementDate).Title("Date").Width(140)
            .Filterable(false)
            .ClientTemplate("#= kendo.toString(kendo.parseDate(JudgementDate), 'MMM dd, yyyy') #");

        columns.Bound(b => b.FileNumbers).Title("File Numbers");
        columns.Bound(b => b.JudgeName).Title("Judge").Width(200);

        columns.Bound(b => b.Count).Title("Cases").Width(100)
            .Filterable(false)
            .ClientTemplate("#= Count # case(s)");

        columns.Bound(b => b.IsFinalized).Title("Status").Width(110)
            .Filterable(false)
            .ClientTemplate(
                "# if (IsFinalized) { #<span class='st-final'>Finalized</span># } " +
                "else { #<span class='st-draft'>Draft</span># } #"
            );

        columns.Bound(b => b.FirstJudgementId).Title("Actions")
            .Sortable(false).Filterable(false).Width(140)
            .ClientTemplate(
                "<div class='row-actions'>" +
                "<a href='" + detailsUrl + "'>View</a>" +
                "# if (!IsFinalized) { #" +
                    "<a href='" + editUrl + "'>Edit</a>" +
                "# } #" +
                "</div>"
            );
    })
    .Pageable(p => p.PageSizes(new[] { 10, 20, 50 }))
    .Sortable()
    .Filterable()
    .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
    .NoRecords(n => n.Template(
        "<div class='py-4 text-center text-muted'>No judgements found. Click \"Add New Judgement\" to create one.</div>"
    ))
)