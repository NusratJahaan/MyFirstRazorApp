@page
@model MyFirstRazorApp.Pages.CourtCase.Judgements.DetailsModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Judgement Details";
    ViewData["ComplaintId"] = Model.Complaint.Id;
    var first = Model.BatchJudgements.FirstOrDefault();
    var isFinalized = Model.BatchJudgements.All(j => j.FinishedAndLocked);
}

<style>
    /* Centers the layout footer text */
    footer {
        text-align: center !important;
    }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <!-- Shared Information -->
            @if (first != null)
            {
                <div class="card shadow-sm border-0 rounded-4 mb-4">
                    <div class="card-body p-4 p-md-5">
                        <h5 class="text-dark fw-bold mb-3">
                            <i class="bi bi-info-circle me-2 text-primary"></i>Judgement Information
                        </h5>

                        <dl class="row mb-0">
                            <dt class="col-sm-3 text-muted fw-semibold">Judge Name</dt>
                            <dd class="col-sm-9 text-dark fw-medium">@first.JudgeName</dd>

                            <dt class="col-sm-3 text-muted fw-semibold">Judgement Date</dt>
                            <dd class="col-sm-9">@first.JudgementDate.ToString("MMM dd, yyyy")</dd>

                            <dt class="col-sm-3 text-muted fw-semibold">Signed Date</dt>
                            <dd class="col-sm-9">@first.SignedDate.ToString("MMM dd, yyyy")</dd>

                            <dt class="col-sm-3 text-muted fw-semibold">Signature Info</dt>
                            <dd class="col-sm-9">@(string.IsNullOrEmpty(first.SignatureInfo) ? "—" : first.SignatureInfo)</dd>

                            <dt class="col-sm-3 text-muted fw-semibold">Status</dt>
                            <dd class="col-sm-9">
                                @if (isFinalized)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill">
                                        <i class="bi bi-lock-fill me-1"></i>Finalized
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-3 py-2 rounded-pill">Draft</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            }

            <!-- Cases Table -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4 pb-3">
                    <h5 class="text-dark fw-bold mb-0">
                        <i class="bi bi-list-check me-2 text-primary"></i>Judged Cases
                    </h5>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3 text-secondary fw-semibold">File Number</th>
                                <th class="py-3 text-secondary fw-semibold">Offence Type</th>
                                <th class="py-3 text-secondary fw-semibold">Disposition</th>
                                <th class="py-3 text-secondary fw-semibold">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var judgement in Model.BatchJudgements)
                            {
                                <tr>
                                    <td class="px-4">
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                                            @Model.GetOffenceFileNumber(judgement.OffenceId)
                                        </span>
                                    </td>
                                    <td class="text-dark fw-medium">@Model.GetOffenceTypeName(judgement.OffenceId)</td>
                                    <td>@judgement.JudgementDisposition</td>
                                    <td class="text-muted small">@(string.IsNullOrEmpty(judgement.Description) ? "—" : judgement.Description)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-3 mt-4">
                <a asp-page="./List" asp-route-complaintId="@Model.Complaint.Id"
                   class="btn btn-light border px-4 text-secondary rounded-pill">
                    Back to List
                </a>

                @if (!isFinalized && first != null)
                {
                    <form method="post" asp-page-handler="Finalize" class="d-inline">
                        <input type="hidden" name="id" value="@first.Id" />
                        <button type="submit" class="btn btn-danger px-4 shadow-sm rounded-pill d-flex align-items-center gap-2"
                                onclick="return confirm('Finalize all judgements in this batch? Cases will become inactive and cannot be edited.');">
                            <i class="bi bi-lock-fill"></i> Finalize Batch
                        </button>
                    </form>
                }
            </div>

        </div>
    </div>
</div>