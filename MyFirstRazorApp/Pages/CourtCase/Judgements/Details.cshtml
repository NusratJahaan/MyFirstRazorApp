@page "{id:int}"
@using MyFirstRazorApp.Models
@model MyFirstRazorApp.Pages.CourtCase.Judgements.DetailsModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Judgement Details";
    ViewData["ComplaintId"] = Model.Complaint.Id;
}

<div class="d-flex align-items-center mb-4 pb-2 border-bottom">
    <a asp-page="List" asp-route-complaintId="@Model.Complaint.Id"
       class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center"
       style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h2 class="text-dark fw-bold mb-0">Judgement Details</h2>
        <p class="text-muted small mb-0">Offence #@Model.Offence.FileNumber</p>
    </div>
</div>

<!-- Judgement Information -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
    <div class="card-body p-4">
        <h5 class="text-dark fw-bold mb-3">
            <i class="bi bi-hammer me-2 text-primary"></i>Judgement Information
        </h5>

        <dl class="row mb-0">
            <dt class="col-sm-3 text-muted fw-semibold">Disposition</dt>
            <dd class="col-sm-9 text-dark fw-medium">@Model.Judgement.JudgementDisposition</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Description</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Judgement.Description) ? "—" : Model.Judgement.Description)</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Judgement Date</dt>
            <dd class="col-sm-9">@Model.Judgement.JudgementDate.ToString("MMM dd, yyyy")</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Judge Name</dt>
            <dd class="col-sm-9">@Model.Judgement.JudgeName</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Signed Date</dt>
            <dd class="col-sm-9">@Model.Judgement.SignedDate.ToString("MMM dd, yyyy")</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Signature Info</dt>
            <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Judgement.SignatureInfo) ? "—" : Model.Judgement.SignatureInfo)</dd>

            <dt class="col-sm-3 text-muted fw-semibold">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Judgement.FinishedAndLocked)
                {
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-lock-fill me-1"></i>Finalized
                    </span>
                }
                else
                {
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-3 py-2 rounded-pill">Draft</span>
                }
            </dd>
        </dl>
    </div>
</div>

<!-- Finalize Button -->
@if (!Model.Judgement.FinishedAndLocked)
{
    <div class="d-flex justify-content-end">
        <form method="post" asp-page-handler="Finalize" class="d-inline">
            <input type="hidden" name="id" value="@Model.Judgement.Id" />
            <button type="submit" class="btn btn-danger px-4 shadow-sm rounded-pill d-flex align-items-center gap-2"
                    onclick="return confirm('Finalize this judgement? The case will become inactive and cannot be edited.');">
                <i class="bi bi-lock-fill"></i> Finalize Judgement
            </button>
        </form>
    </div>
}