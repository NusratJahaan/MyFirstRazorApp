@page "{id:int}"
@model MyFirstRazorApp.Pages.CourtCase.Judgements.EditModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Edit Judgement";
    ViewData["ComplaintId"] = Model.Complaint.Id;
}

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                <a asp-page="List" asp-route-complaintId="@Model.Complaint.Id"
                   class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center"
                   style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-dark fw-bold mb-0">Edit Judgement</h2>
                    <p class="text-muted small mb-0">Offence #@Model.Offence.FileNumber</p>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Judgement.Id" />
                        <input type="hidden" asp-for="Judgement.OffenceId" />
                        <input type="hidden" asp-for="Judgement.CreatedBy" />
                        <input type="hidden" asp-for="Judgement.CreatedDate" />
                        <input type="hidden" asp-for="Judgement.FinishedAndLocked" />

                        <partial name="_JudgementForm" for="Judgement" />

                        <hr class="text-secondary opacity-25 my-4">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="List" asp-route-complaintId="@Model.Complaint.Id"
                               class="btn btn-light border px-4 text-secondary rounded-pill">
                                Cancel
                            </a>
                            <button type="submit"
                                    class="btn btn-primary px-4 shadow-sm rounded-pill d-flex align-items-center gap-2">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}