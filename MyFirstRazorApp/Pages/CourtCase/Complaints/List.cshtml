@page
@using Kendo.Mvc.UI
@model MyFirstRazorApp.Pages.CourtCase.Complaints.ListModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Dashboard";
}

<style>

.tl-section-bar {
    background-color: #e9ecef;     
    padding: 0;              
    display: flex;                  
    align-items: center;
    gap: 8px;                      
    margin-bottom: 6px;
    border-radius: 3px;
}

.tl-banner {
    background-color: #f5c518;
    color: #212529;
    padding: 5px 12px;
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2px;
    border-radius: 2px;
}

.badge-count {
    background-color: #d32f2f;
    color: #ffffff;
    font-weight: 700;
    font-size: 13px;
    padding: 5px 10px;
    display: inline-flex;
    align-items: center;
    border-radius: 2px;
}

    .tl-search-row {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
        padding: 4px 0;
    }

    .tl-search-input {
        display: flex;
        align-items: center;
        background: #ffffff;
        border: 1px solid #ced4da;
        border-radius: 3px;
        padding: 0 8px;
        font-size: 12px;
        height: 28px;
        width: 240px;
    }

    .tl-search-input input {
        border: none;
        outline: none;
        padding: 0 4px;
        font-size: 12px;
        width: 100%;
        height: 100%;
        background: transparent;
    }

    .btn-tl-add {
        background-color: #4a90e2;
        color: #ffffff;
        border: none;
        font-size: 12px;
        padding: 0 12px;
        height: 28px;
        border-radius: 3px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        line-height: 1;
    }

    .btn-tl-add:hover {
        background-color: #357abd;
        color: #ffffff;
    }

    .btn-tl-view {
        background-color: #f0a04b;
        color: #ffffff;
        border: none;
        font-size: 11px;
        padding: 2px 9px;
        border-radius: 3px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-tl-view:hover {
        background-color: #d98934;
        color: #ffffff;
    }

    .btn-tl-edit {
        background-color: #52b788;
        color: #ffffff;
        border: none;
        font-size: 11px;
        padding: 2px 9px;
        border-radius: 3px;
        text-decoration: none;
        display: inline-block;
    }

    .btn-tl-edit:hover {
        background-color: #40916c;
        color: #ffffff;
    }

    .k-grid {
        border-color: #d0d0d0 !important;
        font-size: 12px;
        border-radius: 3px;
    }

    .k-grid-header {
        background-color: #f5f5f5 !important;
    }

    .k-grid-header th.k-header {
        background-color: #e9ecef !important;
        color: #212529 !important;
        font-weight: 700 !important;
        border-bottom: 1px solid #b0b0b0 !important;
        padding: 5px 8px !important;
        font-size: 12px;
    }

    .k-grid td {
        vertical-align: middle;
        padding: 4px 8px !important;
        border-bottom: none !important;
    }

    .k-grid tr:nth-child(even) td {
        background-color: #f8f9fa;
    }

    .k-grid tr:hover td {
        background-color: #eef2f7;
    }

   .k-pager-wrap {
    padding: 4px 8px !important;
    font-size: 12px !important;
    border-top: 1px solid #d0dde5 !important;
    background-color: #E8F0F5 !important;

    .k-pager-wrap .k-link,
    .k-pager-wrap .k-pager-nav {
        min-width: 22px !important;
        height: 22px !important;
        line-height: 22px !important;
        font-size: 11px !important;
        padding: 0 4px !important;
        border-radius: 2px !important;
    }

    .k-pager-wrap .k-state-selected {
        background-color: #f5c518 !important;
        color: #212529 !important;
        border-color: #f5c518 !important;
        font-weight: 700 !important;
    }

    .k-pager-wrap .k-pager-sizes {
        font-size: 11px !important;
    }

    .k-pager-wrap .k-dropdownlist,
    .k-pager-wrap .k-picker {
        font-size: 11px !important;
        height: 22px !important;
    }

    .k-pager-info {
        font-size: 11px !important;
        color: #6c757d !important;
        margin-left: 8px !important;
    }
</style>

<div class="tl-section-bar">
    <div class="tl-banner">Complaints Dashboard</div>
    <span class="badge-count">@Model.Complaints.Count()</span>
</div>

<div class="tl-search-row">
    <form method="get" class="d-flex align-items-center gap-2 m-0">
        <div class="tl-search-input">
            <i class="bi bi-search text-muted"></i>
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   placeholder="Search..." />
        </div>
        <button type="submit" class="btn-tl-add">
            <i class="bi bi-search"></i> Search
        </button>
    </form>
    <a asp-page="Add" class="btn-tl-add">
        <i class="bi bi-plus-circle"></i> Add New Complaint
    </a>
</div>

@(Html.Kendo().Grid(Model.Complaints)
    .Name("complaintsGrid")
    .Columns(columns =>
    {
        columns.Bound(c => c.ComplaintNumber).Title("Case Number").Width(180);
        columns.Bound(c => c.DefendantName).Title("Defendant").Width(200);
        columns.Bound(c => c.DefendantPhone).Title("Phone").Width(160);
        columns.Bound(c => c.DefendantAddress).Title("Address");
        columns.Bound(c => c.Id).Title("Actions")
            .Sortable(false).Filterable(false).Width(160)
            .ClientTemplate(
    "<a href='/CourtCase/Complaints/Details/#= Id #' class='btn-tl-view me-1'>View</a>" +
    "<a href='/CourtCase/Complaints/Edit/#= Id #' class='btn-tl-edit'>Edit</a>"
);
    })
    .Pageable(p => p
        .PageSizes(new[] { 10, 20, 50 })
        .Messages(m => m
            .Display("{0} - {1} of {2} items")
            .Empty("No items to display")
        )
    )
    .Sortable()
    .Filterable()
    .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
    .NoRecords(n => n.Template(
        "<div class='py-4 text-center text-muted'>No complaints found. Click 'Add New Complaint' to create one.</div>"
    ))
)