@page
@using Kendo.Mvc.UI
@using MyFirstRazorApp.Models
@model MyFirstRazorApp.Pages.CourtCase.Complaints.ManageModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Manage Case";
    ViewData["ComplaintId"] = Model.Complaint.Id;

    var offenceTypes = Model.OffenceLookUps.ToDictionary(l => l.Id, l => l.Description);
}

<style>
    .k-grid {
        font-size: 13px;
    }

        .k-grid td {
            vertical-align: middle;
        }

    .row-actions button {
        background: none;
        border: 0;
        padding: 0;
        cursor: pointer;
        font-size: 13px;
    }

        .row-actions button:hover {
            text-decoration: underline;
        }

    .row-actions .act-deactivate {
        color: #c62828;
    }

    .row-actions .act-activate {
        color: #1b7f3b;
    }
</style>

<div class="mb-3">
    <div>
        <h4 class="mb-0">Manage Case</h4>
        <div class="text-muted small">Complaint #@Model.Complaint.ComplaintNumber — @Model.Complaint.DefendantName</div>
    </div>
</div>

<form method="post" asp-page-handler="Toggle" id="toggleForm" class="d-none">
    <input type="hidden" name="id" id="toggleId" />
    <input type="hidden" name="complaintId" value="@Model.Complaint.Id" />
</form>

<script>
    var offenceTypes = @Html.Raw(Json.Serialize(offenceTypes));
</script>

<h6 class="mb-2">Active Cases (@Model.ActiveOffences.Count)</h6>

@(Html.Kendo().Grid(Model.ActiveOffences)
    .Name("activeGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.FileNumber).Title("File Number").Width(160);

        columns.Bound(o => o.OffenceLookUpId).Title("Offence Type").Width(220)
            .Filterable(false)
            .ClientTemplate("#= offenceTypes[OffenceLookUpId] || 'Unknown' #");

        columns.Bound(o => o.Description).Title("Description");

        columns.Bound(o => o.Id).Title("Actions")
            .Sortable(false).Filterable(false).Width(120)
            .ClientTemplate(
                "<div class='row-actions'>" +
                "<button type='button' class='act-deactivate' onclick=\"toggleCase(#= Id #, 'deactivate');\">Deactivate</button>" +
                "</div>"
            );
    })
    .Pageable(p => p.PageSizes(new[] { 10, 20, 50 }))
    .Sortable()
    .Filterable()
    .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
    .NoRecords(n => n.Template("<div class='py-3 text-center text-muted'>No active cases.</div>"))
)

<h6 class="mt-4 mb-2">Inactive Cases (@Model.InactiveOffences.Count)</h6>

@(Html.Kendo().Grid(Model.InactiveOffences)
    .Name("inactiveGrid")
    .Columns(columns =>
    {
        columns.Bound(o => o.FileNumber).Title("File Number").Width(160);

        columns.Bound(o => o.OffenceLookUpId).Title("Offence Type").Width(220)
            .Filterable(false)
            .ClientTemplate("#= offenceTypes[OffenceLookUpId] || 'Unknown' #");

        columns.Bound(o => o.Description).Title("Description");

        columns.Bound(o => o.Id).Title("Actions")
            .Sortable(false).Filterable(false).Width(120)
            .ClientTemplate(
                "<div class='row-actions'>" +
                "<button type='button' class='act-activate' onclick=\"toggleCase(#= Id #, 'activate');\">Activate</button>" +
                "</div>"
            );
    })
    .Pageable(p => p.PageSizes(new[] { 10, 20, 50 }))
    .Sortable()
    .Filterable()
    .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
    .NoRecords(n => n.Template("<div class='py-3 text-center text-muted'>No inactive cases.</div>"))
)

@section Scripts {
    <script>
        function toggleCase(id, action) {
            var message = action === 'activate'
                ? 'Activate this case?'
                : 'Deactivate this case?';

            if (confirm(message)) {
                document.getElementById('toggleId').value = id;
                document.getElementById('toggleForm').submit();
            }
        }
    </script>
}