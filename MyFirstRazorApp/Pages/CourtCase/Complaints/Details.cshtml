@page "{id:int}"
@model MyFirstRazorApp.Pages.CourtCase.Complaints.DetailsModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Defendant Summary";
    ViewData["ComplaintId"] = Model.Complaint.Id;
}

<div class="details-page">

    <h2 class="page-title">Edit Complaint</h2>

    <!-- Complaint Date & Time -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label class="field-label">Complaint Date <span class="text-danger">*</span></label>
            <div class="field-value">@Model.Complaint.CreatedDate.ToString("MM/dd/yyyy")</div>
        </div>
        <div class="col-md-6">
            <label class="field-label">Complaint Time</label>
            <div class="field-value">@Model.Complaint.CreatedDate.ToString("hh:mm tt")</div>
        </div>
    </div>

    <!-- Defendant Information -->
    <h5 class="section-heading">Defendant Information</h5>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <label class="field-label">Defendant Name</label>
            <div class="field-value">@Model.Complaint.DefendantName</div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12">
            <label class="field-label">Phone</label>
            <div class="field-value">
                @(string.IsNullOrEmpty(Model.Complaint.DefendantPhone) ? "—" : Model.Complaint.DefendantPhone)
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-12">
            <label class="field-label">Address</label>
            <div class="field-value">
                @(string.IsNullOrEmpty(Model.Complaint.DefendantAddress) ? "—" : Model.Complaint.DefendantAddress)
            </div>
        </div>
    </div>

    <!-- Case Description -->
    <h5 class="section-heading">Case Description</h5>

    <div class="mb-4">
        @if (string.IsNullOrEmpty(Model.Complaint.Description))
        {
            <p class="text-muted fst-italic mb-0">No description has been recorded for this complaint.</p>
        }
        else
        {
            <div class="field-value" style="min-height: 80px;">@Model.Complaint.Description</div>
        }
    </div>

    <!-- Initial / Last Activity -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <h5 class="section-heading">Initial Activity</h5>
            <div class="activity-list">
                <div class="activity-item">
                    <span class="activity-label">Created By:</span>
                    <span class="activity-value">@(Model.Complaint.CreatedBy ?? "—")</span>
                </div>
                <div class="activity-item">
                    <span class="activity-label">Created On:</span>
                    <span class="activity-value">@Model.Complaint.CreatedDate.ToString("MM/dd/yyyy hh:mm tt")</span>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <h5 class="section-heading">Last Activity</h5>
            <div class="activity-list">
                <div class="activity-item">
                    <span class="activity-label">Updated By:</span>
                    <span class="activity-value">@(Model.Complaint.UpdatedBy ?? "—")</span>
                </div>
                <div class="activity-item">
                    <span class="activity-label">Updated On:</span>
                    <span class="activity-value">@(Model.Complaint.UpdatedDate?.ToString("MM/dd/yyyy hh:mm tt") ?? "—")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
        <a asp-page="./List" class="btn btn-light border px-4">Cancel</a>
        <a asp-page="./Edit" asp-route-id="@Model.Complaint.Id" class="btn btn-primary px-4">Update</a>
    </div>

</div>
