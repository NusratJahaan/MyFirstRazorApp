@page "{id:int}"
@model MyFirstRazorApp.Pages.CourtCase.Complaints.EditModel

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                <a asp-page="Index" class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-dark fw-bold mb-0">Edit Complaint</h2>
                    <p class="text-muted small mb-0">Update defendant details</p>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <!-- ✅ Validation summary -->
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <!-- ✅ Hidden fields -->
                        <input type="hidden" asp-for="Complaint.Id" />
                        <input type="hidden" asp-for="Complaint.ComplaintNumber" />
                        <input type="hidden" asp-for="Complaint.CreatedBy" />
                        <input type="hidden" asp-for="Complaint.CreatedDate" />

                        <!-- Complaint Number Display (read-only) -->
                        <div class="alert alert-info small mb-4">
                            <i class="bi bi-info-circle me-1"></i>
                            Complaint Number: <strong>@Model.Complaint.ComplaintNumber</strong>
                        </div>

                        <partial name="_ComplaintForm" for="Complaint" />

                        <hr class="text-secondary opacity-25 my-4">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="Index" class="btn btn-light border px-4 text-secondary rounded-pill">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm rounded-pill d-flex align-items-center gap-2">
                                <i class="bi bi-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}