@page
@model MyFirstRazorApp.Pages.CourtCase.Complaints.AddModel

<style>
    /* Centers the layout footer text */
    footer {
        text-align: center !important;
    }
</style>

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form method="post">
                        <partial name="_ComplaintForm" for="Complaint" />

                        <hr class="text-secondary opacity-25 my-4">

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="./List" class="btn btn-light border px-4 text-secondary rounded-pill">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm rounded-pill d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle"></i> Create Complaint
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}