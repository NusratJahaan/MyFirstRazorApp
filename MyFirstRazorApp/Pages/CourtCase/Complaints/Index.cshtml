@page
@model MyFirstRazorApp.Pages.CourtCase.Complaints.IndexModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-dark fw-bold mb-0">Complaints Dashboard</h2>
            <p class="text-muted small mb-0">View and manage all complaints</p>
        </div>
        <a asp-page="Create" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Add New Complaint
        </a>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm"
                               class="form-control border-start-0"
                               placeholder="Search by case number, complainant, or defendant name..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Complaints Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        @if (Model.Complaints.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-semibold">Case Number</th>
                            <th class="py-3 text-secondary fw-semibold">Defendant</th>
                            <th class="py-3 text-secondary fw-semibold">Phone</th>
                            <th class="py-3 text-secondary fw-semibold">Address</th>
                            <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var complaint in Model.Complaints)
                        {
                            <tr>
                                <td class="px-4 fw-medium text-dark">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                                        @complaint.ComplaintNumber
                                    </span>
                                </td>
                                <td class="fw-medium text-dark">@complaint.DefendantName</td>
                                <td class="text-muted small">@complaint.DefendantPhone</td>
                                <td class="text-muted small">@complaint.DefendantAddress</td>
                                <td class="px-4 text-end">
                                    <a asp-page="/CourtCase/Cases/Index" asp-route-complaintId="@complaint.Id"
                                       class="btn btn-sm btn-light border text-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <a asp-page="Edit" asp-route-id="@complaint.Id"
                                       class="btn btn-sm btn-light border text-warning">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="display-3 text-muted mb-3 opacity-50">
                    <i class="bi bi-file-earmark-text"></i>
                </div>
                <h4 class="text-dark fw-bold">No complaints found</h4>
                <p class="text-muted">Click "Add New Complaint" to create one.</p>
            </div>
        }
    </div>
</div>