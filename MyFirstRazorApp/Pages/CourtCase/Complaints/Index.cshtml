@page
@using Kendo.Mvc.UI
@model MyFirstRazorApp.Pages.CourtCase.Complaints.IndexModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-dark fw-bold mb-0">Complaints Dashboard</h2>
            <p class="text-muted small mb-0">View and manage all complaints</p>
        </div>
        <a asp-page="Create" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Add New Complaint
        </a>
    </div>

    <!-- Search Bar -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm"
                               class="form-control border-start-0"
                               placeholder="Search by complaint number, defendant name, or phone..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Telerik Grid -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden p-3">
        @(Html.Kendo().Grid(Model.Complaints)
            .Name("complaintsGrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.ComplaintNumber).Title("Case Number").Width(180)
                    .ClientTemplate(
                        "<span class='badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2 rounded-pill'>#= ComplaintNumber #</span>"
                    );
                columns.Bound(c => c.DefendantName).Title("Defendant").Width(200);
                columns.Bound(c => c.DefendantPhone).Title("Phone").Width(160);
                columns.Bound(c => c.DefendantAddress).Title("Address");
                columns.Bound(c => c.Id).Title("Actions")
                    .Sortable(false).Filterable(false).Width(200)
                    .ClientTemplate(
                        "<a href='/CourtCase/Complaints/Details/#= Id #' class='btn btn-sm btn-light border text-primary me-1'>" +
                            "<i class='bi bi-eye'></i> View" +
                        "</a>" +
                        "<a href='/CourtCase/Complaints/Edit/#= Id #' class='btn btn-sm btn-light border text-warning'>" +
                            "<i class='bi bi-pencil'></i> Edit" +
                        "</a>"
                    );
            })
            .Pageable(p => p.PageSizes(new[] { 10, 20, 50 }))
            .Sortable()
            .Filterable()
            .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
            .NoRecords(n => n.Template(
                "<div class='py-5 text-center'>" +
                    "<div class='display-3 text-muted mb-3 opacity-50'><i class='bi bi-file-earmark-text'></i></div>" +
                    "<h4 class='text-dark fw-bold'>No complaints found</h4>" +
                    "<p class='text-muted'>Click 'Add New Complaint' to create one.</p>" +
                "</div>"
            ))
        )
    </div>
</div>