@page
@using Kendo.Mvc.UI
@using MyFirstRazorApp.Models
@model MyFirstRazorApp.Pages.CourtCase.Witnesses.ListModel
@{
    Layout = "_CaseLayout";
    ViewData["Title"] = "Witnesses";
    ViewData["ComplaintId"] = Model.Complaint.Id;

    var editUrl = Url.Page("Edit", new { id = 0 })?.Replace("/0", "/#= Id #");
}

<style>
    .k-grid { font-size: 13px; }
    .k-grid td { vertical-align: middle; }
    .st-victim { color: #c62828; }
    .st-witness { color: #495057; }
    .row-actions a, .row-actions button {
        background: none; border: 0; padding: 0; margin-right: 12px;
        color: #0d6efd; cursor: pointer; text-decoration: none; font-size: 13px;
    }
    .row-actions a:hover, .row-actions button:hover { text-decoration: underline; }
    .row-actions .act-delete { color: #c62828; }
</style>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h4 class="mb-0">Witnesses</h4>
        <div class="text-muted small">Complaint #@Model.Complaint.ComplaintNumber — @Model.Complaint.DefendantName</div>
    </div>
    <a asp-page="Add" asp-route-complaintId="@Model.Complaint.Id" class="k-button k-button-solid k-button-solid-primary">
        Add New Witness
    </a>
</div>

<!-- Hidden Delete Form -->
<form method="post" asp-page-handler="Delete" id="deleteForm" class="d-none">
    <input type="hidden" name="id" id="deleteId" />
    <input type="hidden" name="complaintId" value="@Model.Complaint.Id" />
</form>

@(Html.Kendo().Grid(Model.Witnesses)
    .Name("witnessesGrid")
    .Columns(columns =>
    {
        columns.Bound(w => w.Name).Title("Name").Width(220);
        columns.Bound(w => w.Phone).Title("Phone").Width(160);
        columns.Bound(w => w.Address).Title("Address");

        columns.Bound(w => w.IsVictim).Title("Role").Width(100)
            .Filterable(false)
            .ClientTemplate(
                "# if (IsVictim) { #<span class='st-victim'>Victim</span># } " +
                "else { #<span class='st-witness'>Witness</span># } #"
            );

        columns.Bound(w => w.Id).Title("Actions")
            .Sortable(false).Filterable(false).Width(150)
            .ClientTemplate(
                "<div class='row-actions'>" +
                "<a href='" + editUrl + "'>Edit</a>" +
                "<button type='button' class='act-delete' onclick='deleteWitnessRow(#= Id #);'>Delete</button>" +
                "</div>"
            );
    })
    .Pageable(p => p.PageSizes(new[] { 10, 20, 50 }))
    .Sortable()
    .Filterable()
    .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
    .NoRecords(n => n.Template(
        "<div class='py-4 text-center text-muted'>No witnesses found. Click \"Add New Witness\" to create one.</div>"
    ))
)

@section Scripts {
    <script>
        // Looks up the witness name from the grid data, so names with quotes can't break the button
        function deleteWitnessRow(id) {
            var items = $("#witnessesGrid").data("kendoGrid").dataSource.data();
            var name = "";
            for (var i = 0; i < items.length; i++) {
                if (items[i].Id === id) { name = items[i].Name; break; }
            }
            deleteWitness(id, name);
        }

        function deleteWitness(id, name) {
            if (confirm('Delete witness "' + name + '"?')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}