@model MyFirstRazorApp.Models.Witness

<!-- Name -->
<div class="mb-4">
    <label asp-for="Name" class="form-label fw-semibold text-secondary">Name</label>
    <input asp-for="Name" class="form-control" placeholder="Enter witness's full name" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<!-- Phone -->
<div class="mb-4">
    <label asp-for="Phone" class="form-label fw-semibold text-secondary">Phone</label>
    <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
    <span asp-validation-for="Phone" class="text-danger small"></span>
</div>

<!-- Address -->
<div class="mb-4">
    <label asp-for="Address" class="form-label fw-semibold text-secondary">Address</label>
    <input asp-for="Address" class="form-control" placeholder="Enter address" />
    <span asp-validation-for="Address" class="text-danger small"></span>
</div>

<!-- Is Victim -->
<div class="mb-4">
    <div class="form-check form-switch">
        <input asp-for="IsVictim" class="form-check-input" type="checkbox" role="switch" />
        <label asp-for="IsVictim" class="form-check-label fw-semibold text-secondary">Is this person a victim?</label>
    </div>
</div>

<!-- Statement -->
<div class="mb-4">
    <label asp-for="Statement" class="form-label fw-semibold text-secondary">Statement</label>
    <textarea asp-for="Statement" class="form-control" rows="5" placeholder="Enter witness statement..."></textarea>
    <span asp-validation-for="Statement" class="text-danger small"></span>
</div>