@page
@model MyFirstRazorApp.Pages.IndexModel
@using System.Security.Claims

@{
    int userId = int.Parse(User.Claims.FirstOrDefault(s => s.Type == "UserId")?.Value ?? "0");
    string userName = User.Claims.FirstOrDefault(s => s.Type == ClaimTypes.Name)?.Value ?? "";
    string userEmail = User.Claims.FirstOrDefault(s => s.Type == ClaimTypes.Email)?.Value ?? "";
    string userRole = User.Claims.FirstOrDefault(s => s.Type == ClaimTypes.Role)?.Value ?? "";
}

<div class="container mt-4">
    <h1>Home</h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="alert alert-info">
            <h5>Welcome, @userName!</h5>
            <ul class="mb-0">
                <li><strong>User ID:</strong> @userId</li>
                <li><strong>Email:</strong> @userEmail</li>
                <li><strong>Role:</strong> @userRole</li>
            </ul>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            You are not logged in.
        </div>
    }
</div>