@model MyFirstRazorApp.Models.StudentModels.Course

<td>
    @if (Model.Teacher != null)
    {
        <a asp-page="/Teachers/Details" asp-route-id="@Model.Teacher.Id" class="text-primary text-decoration-none">
            <i class="bi bi-person-badge me-1"></i>@Model.Teacher.Name
        </a>
    }
    else
    {
        <span class="text-muted small fst-italic">Unassigned</span>
    }
</td>
