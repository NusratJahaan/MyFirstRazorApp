@page
@model MyFirstRazorApp.Pages.Courses.IndexModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-dark fw-bold mb-0">Course Directory</h2>
            <p class="text-muted small mb-0">
                @(Model.CurrentRole == "Teacher" ? "Manage your courses" : "Manage and view all courses")
            </p>
        </div>
        @if (Model.CurrentRole == "Coordinator")
        {
            <a asp-page="Create" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i> Add New Course
            </a>
        }
    </div>

    @* ========= COORDINATOR VIEW ========= *@
    @if (Model.CurrentRole == "Coordinator")
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            @if (Model.AllCourses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3 text-secondary fw-semibold">Course</th>
                                <th class="py-3 text-secondary fw-semibold">Description</th>
                                <th class="py-3 text-secondary fw-semibold">Teacher</th>
                                <th class="py-3 text-secondary fw-semibold">Created By</th>
                                <th class="py-3 text-secondary fw-semibold">Created</th>
                                <th class="py-3 text-secondary fw-semibold">Updated By</th>
                                <th class="py-3 text-secondary fw-semibold">Updated</th>
                                <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model.AllCourses)
                            {
                                <tr>
                                    <td class="px-4 fw-medium text-dark">@course.Name</td>
                                    <td class="text-muted">@course.Description</td>
                                    <td>
                                        @if (course.Teacher != null)
                                        {
                                            <a asp-page="/Teachers/Details" asp-route-id="@course.Teacher.Id" class="text-primary text-decoration-none">
                                                @course.Teacher.Name
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Unassigned</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@course.CreatedBy</td>
                                    <td class="text-muted small">@course.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    <td class="text-muted small">@(course.UpdatedBy ?? "—")</td>
                                    <td class="text-muted small">@(course.UpdatedDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                                    <td class="px-4 text-end">
                                        <a asp-page="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-light border text-primary">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h4 class="text-dark fw-bold">No courses found</h4>
                    <p class="text-muted">Create one to get started.</p>
                </div>
            }
        </div>
    }

    @* ========= TEACHER VIEW ========= *@
    @if (Model.CurrentRole == "Teacher")
    {
        <h4 class="mt-3 mb-3">My Courses</h4>
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            @if (Model.MyCourses.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-semibold">Course</th>
                            <th class="py-3 text-secondary fw-semibold">Description</th>
                            <th class="py-3 text-secondary fw-semibold">Students</th>
                            <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.MyCourses)
                        {
                            <tr>
                                <td class="px-4 fw-medium text-dark">@course.Name</td>
                                <td class="text-muted">@course.Description</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2 rounded-pill">
                                        @(course.StudentCourses?.Count ?? 0) student(s)
                                    </span>
                                </td>
                                <td class="px-4 text-end">
                                    <a asp-page="/Courses/Details" asp-route-id="@course.Id" class="btn btn-sm btn-light border text-primary">
                                        <i class="bi bi-eye"></i> View Students
                                    </a>
                                    <form method="post" asp-page-handler="Release" class="d-inline">
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm btn-light border text-danger"
                                                onclick="return confirm('Release this course?');">
                                            <i class="bi bi-x-circle"></i> Release
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-0">You haven't claimed any courses yet.</p>
                </div>
            }
        </div>

        <h4 class="mt-4 mb-3">Available Courses</h4>
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            @if (Model.AvailableCourses.Any())
            {
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-semibold">Course</th>
                            <th class="py-3 text-secondary fw-semibold">Description</th>
                            <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.AvailableCourses)
                        {
                            <tr>
                                <td class="px-4 fw-medium text-dark">@course.Name</td>
                                <td class="text-muted">@course.Description</td>
                                <td class="px-4 text-end">
                                    <form method="post" asp-page-handler="Claim" class="d-inline">
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm btn-light border text-success"
                                                onclick="return confirm('Claim this course?');">
                                            <i class="bi bi-check-circle"></i> Claim
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted mb-0">No available courses to claim right now.</p>
                </div>
            }
        </div>
    }
</div>