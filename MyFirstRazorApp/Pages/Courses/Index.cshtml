@page
@using Kendo.Mvc.UI
@model MyFirstRazorApp.Pages.Courses.IndexModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-dark fw-bold mb-0">Course Directory</h2>
            <p class="text-muted small mb-0">
                @(Model.CurrentRole == "Teacher" ? "Manage your courses" : "Manage and view all courses")
            </p>
        </div>
        @if (Model.CurrentRole == "Coordinator")
        {
            <a asp-page="Create" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-plus-circle"></i> Add New Course
            </a>
        }
    </div>

    @* ========= COORDINATOR VIEW ========= *@
    @if (Model.CurrentRole == "Coordinator")
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden p-3">
            @(Html.Kendo().Grid(Model.AllCourses)
                .Name("coordinatorCoursesGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Name).Title("Course").Width(160);
                    columns.Bound(c => c.Description).Title("Description");
                    columns.Bound(c => c.Teacher.Name).Title("Teacher")
                        .ClientTemplate(
                            "# if (Teacher && Teacher.Name) { #" +
                                "<a href='/Teachers/Details/#= Teacher.Id #' class='text-primary text-decoration-none'>#= Teacher.Name #</a>" +
                            "# } else { #" +
                                "<span class='text-muted small fst-italic'>Unassigned</span>" +
                            "# } #"
                        )
                        .Sortable(false).Filterable(false).Width(140);
                    columns.Bound(c => c.CreatedBy).Title("Created By").Width(130);
                    columns.Bound(c => c.CreatedDate).Title("Created").Format("{0:MMM dd, yyyy}").Width(120);
                    columns.Bound(c => c.UpdatedBy).Title("Updated By").Width(130);
                    columns.Bound(c => c.UpdatedDate).Title("Updated").Format("{0:MMM dd, yyyy}").Width(120);
                    columns.Bound(c => c.Id).Title("Actions")
                        .Sortable(false).Filterable(false).Width(110)
                        .ClientTemplate(
                            "<a href='/Courses/Edit/#= Id #' class='btn btn-sm btn-light border text-primary'>" +
                                "<i class='bi bi-pencil'></i> Edit" +
                            "</a>"
                        );
                })
                .Pageable(p => p.PageSizes(new[] { 10, 20, 50 }))
                .Sortable()
                .Filterable()
                .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
                .NoRecords(n => n.Template(
                    "<div class='py-5 text-center'>" +
                        "<h4 class='text-dark fw-bold'>No courses found</h4>" +
                        "<p class='text-muted'>Create one to get started.</p>" +
                    "</div>"
                ))
            )
        </div>
    }

    @* ========= TEACHER VIEW ========= *@
    @if (Model.CurrentRole == "Teacher")
    {
        <!-- My Courses -->
        <h4 class="mt-3 mb-3">
            <i class="bi bi-check-circle-fill text-success me-2"></i>My Courses
        </h4>
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden p-3 mb-4">
            @(Html.Kendo().Grid(Model.MyCourses)
                .Name("myCoursesGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Name).Title("Course").Width(160);
                    columns.Bound(c => c.Description).Title("Description");
                    columns.Bound(c => c.StudentCourses).Title("Students")
                        .ClientTemplate(
                            "<span class='badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3 py-2 rounded-pill'>" +
                                "#= StudentCourses ? StudentCourses.length : 0 # student(s)" +
                            "</span>"
                        )
                        .Sortable(false).Filterable(false).Width(120);
                    columns.Bound(c => c.Id).Title("Actions")
                        .Sortable(false).Filterable(false).Width(280)
                        .ClientTemplate(
                            "<a href='/Courses/Details/#= Id #' class='btn btn-sm btn-light border text-primary me-1'>" +
                                "<i class='bi bi-eye'></i> View Students" +
                            "</a>" +
                            "<button type='button' class='btn btn-sm btn-light border text-danger' " +
                                "onclick='releaseCourse(#= Id #);'>" +
                                "<i class='bi bi-x-circle'></i> Release" +
                            "</button>"
                        );
                })
                .Pageable(p => p.PageSizes(new[] { 10, 20 }))
                .Sortable()
                .Filterable()
                .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
                .NoRecords(n => n.Template(
                    "<div class='py-4 text-center'>" +
                        "<p class='text-muted mb-0'>You haven't claimed any courses yet.</p>" +
                    "</div>"
                ))
            )
        </div>

        <!-- Hidden Release Form -->
        <form method="post" asp-page-handler="Release" id="releaseForm" class="d-none">
            <input type="hidden" name="courseId" id="releaseCourseId" />
        </form>

        <!-- Available Courses -->
        <h4 class="mt-4 mb-3">
            <i class="bi bi-plus-circle-fill text-primary me-2"></i>Available Courses
        </h4>
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden p-3">
            @(Html.Kendo().Grid(Model.AvailableCourses)
                .Name("availableCoursesGrid")
                .Columns(columns =>
                {
                    columns.Bound(c => c.Name).Title("Course").Width(160);
                    columns.Bound(c => c.Description).Title("Description");
                    columns.Bound(c => c.Id).Title("Actions")
                        .Sortable(false).Filterable(false).Width(150)
                        .ClientTemplate(
                            "<button type='button' class='btn btn-sm btn-light border text-success' " +
                                "onclick='claimCourse(#= Id #);'>" +
                                "<i class='bi bi-check-circle'></i> Claim" +
                            "</button>"
                        );
                })
                .Pageable(p => p.PageSizes(new[] { 10, 20 }))
                .Sortable()
                .Filterable()
                .DataSource(ds => ds.Ajax().ServerOperation(false).PageSize(10))
                .NoRecords(n => n.Template(
                    "<div class='py-4 text-center'>" +
                        "<p class='text-muted mb-0'>No available courses to claim right now.</p>" +
                    "</div>"
                ))
            )
        </div>

        <!-- Hidden Claim Form -->
        <form method="post" asp-page-handler="Claim" id="claimForm" class="d-none">
            <input type="hidden" name="courseId" id="claimCourseId" />
        </form>

        @section Scripts {
            <script>
                    function claimCourse(id) {
                        if (confirm('Claim this course?')) {
                            document.getElementById('claimCourseId').value = id;
                            document.getElementById('claimForm').submit();
                        }
                    }

                    function releaseCourse(id) {
                        if (confirm('Release this course?')) {
                            document.getElementById('releaseCourseId').value = id;
                            document.getElementById('releaseForm').submit();
                        }
                    }
            </script>
        }
    }
</div>