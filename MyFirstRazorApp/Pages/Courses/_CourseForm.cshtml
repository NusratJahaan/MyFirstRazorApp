@model MyFirstRazorApp.Models.Course
@using System.Security.Claims

@{
    var currentUserName = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value ?? "System";
}

<input type="hidden" asp-for="CreatedDate" value="@DateTime.Now" />
<input type="hidden" asp-for="UpdatedDate" value="@DateTime.Now" />
<input type="hidden" asp-for="CreatedBy" value="@currentUserName" />
<input type="hidden" asp-for="UpdatedBy" value="@currentUserName" />

<div class="form-group">
    <label asp-for="Name" class="control-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Description" class="control-label"></label>
    <input asp-for="Description" class="form-control" />
    <span asp-validation-for="Description" class="text-danger"></span>
</div>