@model MyFirstRazorApp.Models.Coordinator

<!-- Name Field -->
<div class="mb-4">
    <label asp-for="Name" class="form-label fw-semibold text-secondary"></label>
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white text-muted border-end-0 px-3">
            <i class="bi bi-person"></i>
        </span>
        <input asp-for="Name" class="form-control py-2 border-start-0 ps-0" placeholder="Enter coordinator's full name" />
    </div>
    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
</div>

<!-- Email Field -->
<div class="mb-4">
    <label asp-for="Email" class="form-label fw-semibold text-secondary"></label>
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white text-muted border-end-0 px-3">
            <i class="bi bi-envelope"></i>
        </span>
        <input asp-for="Email" class="form-control py-2 border-start-0 ps-0" placeholder="name@example.com" />
    </div>
    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
</div>

<!-- Phone Field -->
<div class="mb-4">
    <label asp-for="Phone" class="form-label fw-semibold text-secondary"></label>
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white text-muted border-end-0 px-3">
            <i class="bi bi-telephone"></i>
        </span>
        <input asp-for="Phone" class="form-control py-2 border-start-0 ps-0" placeholder="e.g. +1 (555) 000-0000" type="tel" />
    </div>
    <span asp-validation-for="Phone" class="text-danger small mt-1 d-block"></span>
</div>

<!-- Department Field -->
<div class="mb-3">
    <label asp-for="Department" class="form-label fw-semibold text-secondary"></label>
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white text-muted border-end-0 px-3">
            <i class="bi bi-building"></i>
        </span>
        <input asp-for="Department" class="form-control py-2 border-start-0 ps-0" placeholder="e.g. Computer Science & Engineering" />
    </div>
    <span asp-validation-for="Department" class="text-danger small mt-1 d-block"></span>
</div>