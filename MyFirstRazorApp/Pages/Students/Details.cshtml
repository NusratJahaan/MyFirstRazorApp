@page "{id:int}"
@model MyFirstRazorApp.Pages.Students.DetailsModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <a asp-page="Index" class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="text-dark fw-bold mb-0">@Model.Student.Name</h2>
            <p class="text-muted small mb-0">Student details and enrolled courses</p>
        </div>
    </div>

    <!-- Student Info Card -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-4">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-person display-5"></i>
                </div>
                <div>
                    <h4 class="text-dark fw-bold mb-1">@Model.Student.Name</h4>
                    <p class="text-muted mb-2">
                        <i class="bi bi-envelope me-1"></i>@Model.Student.Email
                    </p>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle px-3 py-2 rounded-pill">
                        @Model.EnrolledCourses.Count course(s)
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Enrolled Courses -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-4 pb-3">
            <h5 class="text-dark fw-bold mb-0">Enrolled Courses</h5>
        </div>

        @if (Model.EnrolledCourses.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-semibold">Course</th>
                            <th class="py-3 text-secondary fw-semibold">Description</th>
                            <th class="py-3 text-secondary fw-semibold">Teacher</th>
                            <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.EnrolledCourses)
                        {
                            <tr>
                                <td class="px-4 fw-medium text-dark">
                                    <i class="bi bi-journal-text text-primary me-2"></i>@course.Name
                                </td>
                                <td class="text-muted small">@(course.Description ?? "—")</td>
                                <td>
                                    @if (course.Teacher != null)
                                    {
                                        <a asp-page="/Teachers/Details" asp-route-id="@course.Teacher.Id" class="text-primary text-decoration-none">
                                            <i class="bi bi-person-badge me-1"></i>@course.Teacher.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Unassigned</span>
                                    }
                                </td>
                                <td class="px-4 text-end">
                                    <a asp-page="/Courses/Details" asp-route-id="@course.Id" class="btn btn-sm btn-light border text-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="display-4 text-muted mb-3 opacity-50">
                    <i class="bi bi-journal-x"></i>
                </div>
                <h5 class="text-dark fw-bold">No courses enrolled</h5>
                <p class="text-muted small mb-0">This student hasn't enrolled in any courses yet.</p>
            </div>
        }
    </div>
</div>
