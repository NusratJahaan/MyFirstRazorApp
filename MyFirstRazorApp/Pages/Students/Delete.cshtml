@page "{id:int}"
@using Kendo.Mvc.UI
@model MyFirstRazorApp.Pages.Students.DeleteModel

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- Header Section -->
            <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                <a asp-page="Index" class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%;" title="Back to List">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-dark fw-bold mb-0">Delete Student</h2>
                    <p class="text-danger small mb-0 fw-semibold">This action cannot be undone</p>
                </div>
            </div>

            <!-- Warning & Details Card -->
            <div class="card shadow-sm border-0 border-top border-danger border-4 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">

                    <!-- Alert Icon & Message -->
                    <div class="text-center mb-4 pb-2">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-exclamation-triangle-fill display-4"></i>
                        </div>
                        <h4 class="text-dark fw-bold">Are you absolutely sure?</h4>
                        <p class="text-muted">You are about to permanently delete the record for <strong class="text-dark">@Model.Student.Name</strong>.</p>
                    </div>

                    <!-- Read-Only Data Display -->
                    <div class="bg-light rounded-4 p-4 mb-4 border border-light-subtle">
                        <dl class="row gy-3 mb-0">
                            <dt class="col-sm-4 text-muted fw-semibold">Name</dt>
                            <dd class="col-sm-8 text-dark mb-0 fw-medium">@Model.Student.Name</dd>

                            <dt class="col-sm-4 text-muted fw-semibold">Email</dt>
                            <dd class="col-sm-8 text-dark mb-0">@Model.Student.Email</dd>

                            <dt class="col-sm-4 text-muted fw-semibold">Age</dt>
                            <dd class="col-sm-8 text-dark mb-0">@Model.Student.Age</dd>

                            <dt class="col-sm-4 text-muted fw-semibold">Course</dt>
                            <dd class="col-sm-8 text-dark mb-0">
                                @if (Model.Student.Course?.Name != null)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-2 py-1">
                                        @Model.Student.Course.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Unassigned</span>
                                }
                            </dd>

                            <dt class="col-sm-4 text-muted fw-semibold">Created</dt>
                            <dd class="col-sm-8 text-muted small mb-0">@Model.Student.CreatedDate.ToString("MMM dd, yyyy")</dd>

                            <dt class="col-sm-4 text-muted fw-semibold">Updated</dt>
                            <dd class="col-sm-8 text-muted small mb-0">@(Model.Student.UpdatedDate?.ToString("MMM dd, yyyy") ?? "--")</dd>
                        </dl>
                    </div>

                    <!-- Action Buttons -->
                    <form method="post">
                        <input type="hidden" asp-for="Student.Id" />
                        <div class="d-flex justify-content-center gap-3 mt-2">
                            <a asp-page="Index" class="btn btn-light border px-4 text-secondary rounded-pill">
                                Cancel
                            </a>
                            @(Html.Kendo().Button()
                                .Name("btnDelete")
                                .HtmlAttributes(new { type = "submit", @class = "btn btn-danger px-4 shadow-sm rounded-pill" })
                                .Content("<i class='bi bi-trash3-fill me-1'></i> Yes, Delete Student")
                            )
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>