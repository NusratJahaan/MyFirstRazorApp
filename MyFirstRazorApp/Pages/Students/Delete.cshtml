@page "{id:int}"
@model MyFirstRazorApp.Pages.Students.DeleteModel

<h2>Delete Student</h2>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this student?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Student.Name</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Student.Email</dd>

        <dt class="col-sm-2">Age</dt>
        <dd class="col-sm-10">@Model.Student.Age</dd>

        <dt class="col-sm-2">Course</dt>
        <dd class="col-sm-10">@Model.Student.Course</dd>
    </dl>
</div>

<form method="post">
    <input type="hidden" asp-for="Student.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
