@page
@model MyFirstRazorApp.Pages.Students.CreateModel

<div class="container-fluid mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <!-- Header Section -->
            <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
                <a asp-page="Index" class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%;" title="Back to List">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h2 class="text-dark fw-bold mb-0">Add New Student</h2>
                    <p class="text-muted small mb-0">Enter the student's details below to enroll them</p>
                </div>
            </div>

            <!-- Form Card -->
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">
                    <form method="post">

                        <!-- Form Fields Partial -->
                        <div class="mb-4">
                            <partial name="_StudentForm" for="Student" />
                        </div>

                        <hr class="text-secondary opacity-25 my-4">

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-3 mt-2">
                            <a asp-page="Index" class="btn btn-light border px-4 text-secondary rounded-pill">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm rounded-pill d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle"></i> Create Student
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}