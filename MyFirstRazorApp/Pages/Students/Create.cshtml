@page 
@model MyFirstRazorApp.Pages.Students.CreateModel

<h2>Add New Student</h2>

<form method="post">
    <input type="hidden" asp-for="Student.CreatedDate" value="@DateTime.Now" />
    <input type="hidden" asp-for="Student.UpdatedDate" value="@DateTime.Now" />
    <partial name="_StudentForm" for="Student" />
    <div class="form-group mt-3">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-page="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}