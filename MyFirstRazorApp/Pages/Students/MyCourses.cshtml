@page
@model MyFirstRazorApp.Pages.Students.MyCoursesModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <a asp-page="Index" class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="text-dark fw-bold mb-0">My Courses</h2>
            <p class="text-muted small mb-0">Enroll or unenroll in available courses</p>
        </div>
    </div>

    <!-- My Enrolled Courses -->
    <h4 class="mt-3 mb-3">
        <i class="bi bi-check-circle-fill text-success me-2"></i>Enrolled Courses
    </h4>
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
        @if (Model.EnrolledCourses.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-semibold">Course</th>
                            <th class="py-3 text-secondary fw-semibold">Description</th>
                            <th class="py-3 text-secondary fw-semibold">Teacher</th>
                            <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.EnrolledCourses)
                        {
                            <tr>
                                <td class="px-4 fw-medium text-dark">
                                    <i class="bi bi-journal-text text-primary me-2"></i>@course.Name
                                </td>
                                <td class="text-muted small">@(course.Description ?? "—")</td>
                                <td>
                                    @if (course.Teacher != null)
                                    {
                                        <a asp-page="/Teachers/Details" asp-route-id="@course.Teacher.Id" class="text-primary text-decoration-none">
                                            <i class="bi bi-person-badge me-1"></i>@course.Teacher.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Unassigned</span>
                                    }
                                </td>
                                <td class="px-4 text-end">
                                    <a asp-page="/Courses/Details" asp-route-id="@course.Id" class="btn btn-sm btn-light border text-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    <form method="post" asp-page-handler="Unenroll" class="d-inline">
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm btn-light border text-danger"
                                                onclick="return confirm('Remove this course from your enrollment?');">
                                            <i class="bi bi-x-circle"></i> Remove
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <p class="text-muted mb-0">You haven't enrolled in any courses yet.</p>
            </div>
        }
    </div>

    <!-- Available Courses -->
    <h4 class="mt-4 mb-3">
        <i class="bi bi-plus-circle-fill text-primary me-2"></i>Available Courses
    </h4>
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        @if (Model.AvailableCourses.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-semibold">Course</th>
                            <th class="py-3 text-secondary fw-semibold">Description</th>
                            <th class="py-3 text-secondary fw-semibold">Teacher</th>
                            <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model.AvailableCourses)
                        {
                            <tr>
                                <td class="px-4 fw-medium text-dark">
                                    <i class="bi bi-journal-text text-primary me-2"></i>@course.Name
                                </td>
                                <td class="text-muted small">@(course.Description ?? "—")</td>
                                <td>
                                    @if (course.Teacher != null)
                                    {
                                        <a asp-page="/Teachers/Details" asp-route-id="@course.Teacher.Id" class="text-primary text-decoration-none">
                                            <i class="bi bi-person-badge me-1"></i>@course.Teacher.Name
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Unassigned</span>
                                    }
                                </td>
                                <td class="px-4 text-end">
                                    <form method="post" asp-page-handler="Enroll" class="d-inline">
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm btn-light border text-success"
                                                onclick="return confirm('Enroll in this course?');">
                                            <i class="bi bi-plus-circle"></i> Enroll
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <p class="text-muted mb-0">No available courses to enroll in right now.</p>
            </div>
        }
    </div>
</div>