@page
@model MyFirstRazorApp.Pages.Students.IndexModel

<h2>Student List</h2>

<p>
    <a asp-page="Create" class="btn btn-primary">Add New Student</a>
</p>

@if (Model.Students.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Age</th>
                <th>Course</th>
                <th>Created</th>
                <th>Updated</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
            {
                <tr>
                    <td>@student.Name</td>
                    <td>@student.Email</td>
                    <td>@student.Age</td>
                   <td>@student.Course?.Name</td>
                    <td>@student.CreatedDate.ToString("yyyy-MM-dd")</td>
                    <td>@student.UpdatedDate?.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="Edit" asp-route-id="@student.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@student.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No students found. Add one now!</p>
}