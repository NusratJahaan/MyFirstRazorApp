@page
@using Kendo.Mvc.UI
@model MyFirstRazorApp.Pages.Students.IndexModel

<div class="container-fluid mt-4 mb-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-dark fw-bold mb-0">Student Directory</h2>
            <p class="text-muted small mb-0">Manage and view all enrolled students</p>
        </div>

        <a asp-page="Create"
           class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-person-plus-fill"></i>
            Add New Student
        </a>
    </div>

    <!-- Telerik Data Grid -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden p-2">

        @(Html.Kendo().Grid(Model.Students)
            .Name("StudentsGrid")
            .Columns(columns =>
            {
                columns.Bound(c => c.Name)
                    .Title("Name")
                    .Width(200);

                columns.Bound(c => c.Email)
                    .Title("Email")
                    .Width(250);

                columns.Bound(c => c.Age)
                    .Title("Age")
                    .Width(100);

                columns.Bound(c => c.Course)
                    .Title("Course")
                    .ClientTemplate(
                        "#= Course && Course.Name " +
                        "? Course.Name " +
                        ": '<span class=\"text-muted small fst-italic\">Unassigned</span>' #"
                    );

                columns.Bound(c => c.CreatedDate)
                    .Format("{0:MMM dd, yyyy}")
                    .Title("Created")
                    .Width(150);

                columns.Bound(c => c.UpdatedDate)
                    .Format("{0:MMM dd, yyyy}")
                    .Title("Updated")
                    .Width(150);

                columns.Bound(c => c.Id)
                    .Title("Actions")
                    .Width(200)
                    .Sortable(false)
                    .Filterable(false)
                    .ClientTemplate(
                        "<div class='btn-group shadow-sm'>" +
                            "<a href='" + Url.Page("Edit") +
                            "?id=#=Id#' " +
                            "class='btn btn-sm btn-light border text-primary'>" +
                                "<i class='bi bi-pencil-square'></i> Edit" +
                            "</a> " +

                            "<a href='" + Url.Page("Delete") +
                            "?id=#=Id#' " +
                            "class='btn btn-sm btn-light border text-danger'>" +
                                "<i class='bi bi-trash'></i> Delete" +
                            "</a>" +
                        "</div>"
                    );
            })
            .Pageable(pageable => pageable
                .PageSizes(new[] { 10, 20, 50 })
            )
            .Sortable()
            .Filterable()
            .NoRecords(n => n.Template(
                "<div class='py-5 text-center'>" +
                    "<h4 class='text-dark fw-bold'>No students found</h4>" +
                    "<p class='text-muted'>Your student directory is currently empty.</p>" +
                "</div>"
            ))
        )

    </div>
</div>