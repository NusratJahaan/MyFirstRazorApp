@page
@model MyFirstRazorApp.Pages.Students.IndexModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="text-dark fw-bold mb-0">
                @(Model.CurrentRole == "Student" ? "My Profile" : "Student Directory")
            </h2>
            <p class="text-muted small mb-0">
                @(Model.CurrentRole == "Student" 
                    ? "Your student record and courses" 
                    : "Manage and view all enrolled students")
            </p>
        </div>
        @if (Model.CurrentRole == "Student" && Model.CurrentStudentId > 0)
        {
            <a asp-page="/Students/MyCourses" class="btn btn-primary shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-journal-text"></i> My Courses
            </a>
        }
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        @if (Model.Students.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-semibold">Name</th>
                            <th class="py-3 text-secondary fw-semibold">Email</th>
                            @if (Model.CurrentRole != "Student")
                            {
                                <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td class="px-4 fw-medium text-dark">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-primary"></i>
                                        </div>
                                        @student.Name
                                    </div>
                                </td>
                                <td class="text-muted">@student.Email</td>
                                @if (Model.CurrentRole != "Student")
                                {
                                    <td class="px-4 text-end">
                                        <a asp-page="/Students/Details" asp-route-id="@student.Id" class="btn btn-sm btn-light border text-primary">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="display-3 text-muted mb-3 opacity-50">
                    <i class="bi bi-people"></i>
                </div>
                <h4 class="text-dark fw-bold">No students found</h4>
            </div>
        }
    </div>
</div>