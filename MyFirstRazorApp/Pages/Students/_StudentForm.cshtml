@model MyFirstRazorApp.Models.Student
@using Microsoft.AspNetCore.Mvc.Rendering

<!-- Hidden Fields -->
<input type="hidden" asp-for="CreatedBy" value="Nusrat" />
<input type="hidden" asp-for="UpdatedBy" value="Nusrat" />
<input type="hidden" asp-for="CreatedDate" value="@DateTime.Now" />
<input type="hidden" asp-for="UpdatedDate" value="@DateTime.Now" />

<!-- Name -->
<div class="mb-4">
    <label asp-for="Name" class="form-label fw-semibold text-secondary"></label>
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white text-muted border-end-0 px-3">
            <i class="bi bi-person"></i>
        </span>
        <input asp-for="Name" class="form-control py-2 border-start-0 ps-0" placeholder="Enter student's full name" />
    </div>
    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
</div>

<!-- Email -->
<div class="mb-4">
    <label asp-for="Email" class="form-label fw-semibold text-secondary"></label>
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white text-muted border-end-0 px-3">
            <i class="bi bi-envelope"></i>
        </span>
        <input asp-for="Email" class="form-control py-2 border-start-0 ps-0" placeholder="name@example.com" />
    </div>
    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
</div>

<!-- Age -->
<div class="mb-4">
    <label asp-for="Age" class="form-label fw-semibold text-secondary"></label>
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white text-muted border-end-0 px-3">
            <i class="bi bi-123"></i>
        </span>
        <input asp-for="Age" class="form-control py-2 border-start-0 ps-0" placeholder="Enter age" type="number" />
    </div>
    <span asp-validation-for="Age" class="text-danger small mt-1 d-block"></span>
</div>

<!-- Course -->
<div class="mb-3">
    <label asp-for="CourseId" class="form-label fw-semibold text-secondary"></label>
    <div class="input-group shadow-sm">
        <span class="input-group-text bg-white text-muted border-end-0 px-3">
            <i class="bi bi-journal-text"></i>
        </span>
        <select asp-for="CourseId" class="form-select py-2 border-start-0 ps-0"
                asp-items="@(ViewData["CourseOptions"] as List<SelectListItem>)">
            <option value="">-- Select Enrolled Course --</option>
        </select>
    </div>
    <span asp-validation-for="CourseId" class="text-danger small mt-1 d-block"></span>
</div>