@page "{courseId:int}"
@model MyFirstRazorApp.Pages.Students.ByCourseModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <a asp-page="/Teachers/Index" class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%;" title="Back to Teachers">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="text-dark fw-bold mb-0">Students in @Model.CourseName</h2>
            <p class="text-muted small mb-0">Viewing all students currently enrolled in this course</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        @if (Model.Students.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 text-secondary fw-semibold">Name</th>
                            <th class="py-3 text-secondary fw-semibold">Email</th>
                            <th class="py-3 text-secondary fw-semibold text-center">Age</th>
                            <th class="px-4 py-3 text-secondary fw-semibold text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td class="px-4 fw-medium text-dark">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            <i class="bi bi-person text-primary"></i>
                                        </div>
                                        @student.Name
                                    </div>
                                </td>
                                <td class="text-muted">@student.Email</td>
                                <td class="text-center">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle rounded-pill">
                                        @student.Age
                                    </span>
                                </td>
                                <td class="px-4 text-end">
                                    <a asp-page="/Students/Edit" asp-route-id="@student.Id" class="btn btn-sm btn-light border d-inline-flex align-items-center gap-1 text-primary shadow-sm">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-5">
                <div class="display-3 text-muted mb-3 opacity-50">
                    <i class="bi bi-journal-x"></i>
                </div>
                <h4 class="text-dark fw-bold">No students enrolled</h4>
                <p class="text-muted mb-4">There are currently no students assigned to <span class="fw-semibold">@Model.CourseName</span>.</p>
                <a asp-page="/Teachers/Index" class="btn btn-outline-secondary rounded-pill px-4 d-inline-flex align-items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Return to Teachers
                </a>
            </div>
        }
    </div>
</div>