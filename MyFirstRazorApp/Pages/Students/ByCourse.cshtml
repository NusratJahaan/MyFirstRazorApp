@page "{courseId:int}"
@model MyFirstRazorApp.Pages.Students.ByCourseModel

<h2>Students in @Model.CourseName</h2>

<p>
    <a asp-page="/Teachers/Index" class="btn btn-secondary">Back to Teachers</a>
</p>

@if (Model.Students.Any())
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Age</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model.Students)
            {
                <tr>
                    <td>@student.Name</td>
                    <td>@student.Email</td>
                    <td>@student.Age</td>
                    <td>
                        <a asp-page="/Students/Edit" asp-route-id="@student.Id">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No students enrolled in this course.</p>
}
