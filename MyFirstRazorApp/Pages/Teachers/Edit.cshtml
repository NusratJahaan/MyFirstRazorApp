@page "{id:int}"
@model MyFirstRazorApp.Pages.Teachers.EditModel

<h2>Edit Teacher</h2>

<form method="post">
    <input type="hidden" asp-for="Teacher.Id" />

    <div class="form-group">
        <label asp-for="Teacher.Name"></label>
        <input asp-for="Teacher.Name" class="form-control" />
        <span asp-validation-for="Teacher.Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Teacher.Email"></label>
        <input asp-for="Teacher.Email" class="form-control" />
        <span asp-validation-for="Teacher.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Teacher.Specialization"></label>
        <input asp-for="Teacher.Specialization" class="form-control" />
        <span asp-validation-for="Teacher.Specialization" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Teacher.CourseId"></label>
        <select asp-for="Teacher.CourseId" class="form-control" asp-items="Model.CourseOptions">
            <option value="">-- Select Course --</option>
        </select>
        <span asp-validation-for="Teacher.CourseId" class="text-danger"></span>
    </div>

    <div class="form-group mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}s