@page "{id:int}"
@model MyFirstRazorApp.Pages.Teachers.EditModel

<h2>Edit Teacher</h2>
Component

<form method="post">
    <input type="hidden" asp-for="Teacher.Id" />

    <partial name="_TeacherForm" for="Teacher" />

    <div class="form-group mt-3">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-page="Index" class="btn btn-secondary">Back</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}s