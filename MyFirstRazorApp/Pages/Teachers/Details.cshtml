@page "{id:int}"
@model MyFirstRazorApp.Pages.Teachers.DetailsModel

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex align-items-center mb-4 pb-2 border-bottom">
        <a asp-page="Index" class="btn btn-light border shadow-sm text-muted me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 50%;" title="Back">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h2 class="text-dark fw-bold mb-0">@Model.Teacher.Name</h2>
            <p class="text-muted small mb-0">Teacher details and courses</p>
        </div>
    </div>

    <!-- Teacher Info Card -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-person-badge display-5"></i>
                </div>
                <div>
                    <h4 class="text-dark fw-bold mb-1">@Model.Teacher.Name</h4>
                    <p class="text-muted mb-2">
                        <i class="bi bi-envelope me-1"></i>@Model.Teacher.Email
                    </p>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info-subtle px-3 py-2 rounded-pill">
                        @Model.Courses.Count course(s)
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Courses with Students -->
    @if (Model.Courses.Any())
    {
        @foreach (var course in Model.Courses)
        {
            var students = Model.CourseStudents.ContainsKey(course.Id) 
                ? Model.CourseStudents[course.Id] 
                : new List<MyFirstRazorApp.Models.Student>();

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="card-body p-4 pb-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="text-dark fw-bold mb-1">
                            <i class="bi bi-journal-text text-primary me-2"></i>@course.Name
                        </h5>
                        <p class="text-muted small mb-0">@(course.Description ?? "No description")</p>
                    </div>
                    <a asp-page="/Courses/Details" asp-route-id="@course.Id" class="btn btn-sm btn-light border text-primary">
                        <i class="bi bi-eye"></i> View Course
                    </a>
                </div>

                @if (students.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-2 text-secondary fw-semibold small">Enrolled Student</th>
                                    <th class="py-2 text-secondary fw-semibold small">Email</th>
                                    <th class="px-4 py-2 text-secondary fw-semibold small text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in students)
                                {
                                    <tr>
                                        <td class="px-4 fw-medium text-dark small">
                                            <i class="bi bi-person-circle text-primary me-2"></i>@student.Name
                                        </td>
                                        <td class="text-muted small">@student.Email</td>
                                        <td class="px-4 text-end">
                                            <a asp-page="/Students/Details" asp-route-id="@student.Id" class="btn btn-sm btn-light border text-primary">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="px-4 py-3 text-muted small fst-italic border-top">
                        <i class="bi bi-info-circle me-1"></i>No students enrolled in this course yet.
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="text-center py-5">
                <div class="display-4 text-muted mb-3 opacity-50">
                    <i class="bi bi-journal-x"></i>
                </div>
                <h5 class="text-dark fw-bold">No courses yet</h5>
                <p class="text-muted small mb-0">This teacher hasn't claimed any courses.</p>
            </div>
        </div>
    }
</div>