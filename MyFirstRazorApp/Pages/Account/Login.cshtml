@page
@model MyFirstRazorApp.Pages.Account.LoginModel

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-4">
                        <h2 class="text-dark fw-bold mb-1">Welcome Back</h2>
                        <p class="text-muted small">Sign in to your account</p>
                    </div>

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-semibold text-secondary"></label>
                            <input asp-for="Input.Password" class="form-control" placeholder="Enter password" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Input.RememberMe" class="form-check-input" />
                            <label asp-for="Input.RememberMe" class="form-check-label text-secondary small"></label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill shadow-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </button>
                    </form>

                    <hr class="text-secondary opacity-25 my-4">

                    <p class="text-center text-muted small mb-0">
                        Don't have an account?
                        <a asp-page="/Account/Register" class="text-primary text-decoration-none fw-semibold">Register here</a>
                    </p>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}